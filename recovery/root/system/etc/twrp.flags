# mount point      fstype    device                                      device2               flags
/recovery          emmc      /dev/block/platform/bootdevice/by-name/recovery                   flags=display="Recovery";backup=1;flashimg=1
/boot              emmc      /dev/block/platform/bootdevice/by-name/boot                       flags=backup=1;display="Boot";flashimg=1
/system_image      emmc      /dev/block/by-name/system                                         flags=backup=1;flashimg=1
/system_root       ext4      /dev/block/by-name/system                                         flags=display="System";wipeingui;backup=0
/cache             ext4      /dev/block/platform/bootdevice/by-name/cache
/data              ext4      /dev/block/platform/bootdevice/by-name/userdata                   flags=fileencryption=aes-256-xts:aes-256-cts:v1
/vendor_image      emmc      /dev/block/by-name/vendor                                         flags=backup=1;flashimg=1
/vendor            ext4      /dev/block/by-name/vendor                                         flags=backup=0;display="Vendor";wipeingui
/persistent        emmc      /dev/block/platform/bootdevice/by-name/frp                        flags=display="Frp";backup=1
/expdb             emmc      /dev/block/platform/bootdevice/by-name/expdb                      flags=display="Expdb";backup=1;flashimg=0
/misc              emmc      /dev/block/platform/bootdevice/by-name/para                       flags=display="Para";backup=1
/persist           emmc      /dev/block/by-name/persist                                        flags=display="Persist";backup=1;wipeingui=0;flashimg=0
#/metadata         ext4      /dev/block/platform/bootdevice/by-name/metadata                   flags=display="Metadata";wipeingui;backup=1
/boot_para         emmc      /dev/block/platform/bootdevice/by-name/boot_para                  flags=display="boot_para";backup=1
/dtbo              emmc      /dev/block/platform/bootdevice/by-name/dtbo                       flags=display="Dtbo";backup=1

# IMEI and modem related
# below four partitions are ext4, but we are using only for backup so emmc
/protect_f         emmc      /dev/block/platform/bootdevice/by-name/protect1                   flags=display="Protect";backup=1
/protect_s         emmc      /dev/block/platform/bootdevice/by-name/protect2                   flags=subpartitionof=/protect_f;backup=1
/nvdata            emmc      /dev/block/platform/bootdevice/by-name/nvdata                     flags=backup=1;display="Nvdata";flashimg=0
/nvcfg             emmc      /dev/block/platform/bootdevice/by-name/nvcfg                      flags=backup=1;display="Nvcfg";flashimg=0
/nvram             emmc      /dev/block/platform/bootdevice/by-name/nvram                      flags=backup=1;display="Nvram";flashimg=0
/md1img            emmc      /dev/block/platform/bootdevice/by-name/md1img                     flags=display="Modem";backup=1

# testing odm
#/odm              emmc      /dev/block/platform/bootdevice/by-name/odm                        flags=backup=1;display="Odm";flashimg=1

/seccfg            emmc      /dev/block/platform/bootdevice/by-name/seccfg
/spmfw             emmc      /dev/block/platform/bootdevice/by-name/spmfw                      flags=display="Spm";backup=1
/sspm_1            emmc      /dev/block/platform/bootdevice/by-name/sspm_1                     flags=backup=1;subpartitionof=/spmfw
/sspm_2            emmc      /dev/block/platform/bootdevice/by-name/sspm_2                     flags=backup=1;subpartitionof=/spmfw
/proinfo           emmc      /dev/block/platform/bootdevice/by-name/proinfo                    flags=display="Proinfo";backup=1
/odmdtbo           emmc      /dev/block/platform/bootdevice/by-name/odmdtbo
/lk                emmc      /dev/block/platform/bootdevice/by-name/lk                         flags=display="lk";backup=1
/lk2               emmc      /dev/block/platform/bootdevice/by-name/lk2                        flags=backup=1;subpartitionof=/lk
/logo              emmc      /dev/block/platform/bootdevice/by-name/logo                       flags=display="Logo";backup=1;flashimg=1
/tee1              emmc      /dev/block/platform/bootdevice/by-name/tee1                       flags=display="Tee";backup=1
/tee2              emmc      /dev/block/platform/bootdevice/by-name/tee2                       flags=backup=1;subpartitionof=/tee1
/opporeserve       emmc      /dev/block/by-name/opporeserve2                                   flags=backup=1;display="Opporeserve2";flashimg=0


# External-Devices (SDCARD | OTG)
/external_sd       vfat      /dev/block/mmcblk0p1          /dev/block/mmcblk0                  flags=display="Micro SD card";storage;wipeingui;removable
/usb_otg           auto      /dev/block/sdd1               /dev/block/sdd                      flags=display="Usb-Otg";storage;wipeingui;removable
